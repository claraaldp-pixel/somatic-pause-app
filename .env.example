# Neon database, managed Auth, and Data API endpoints.
NEON_DATABASE_URL=postgresql://user:password@host/database?sslmode=require
NEON_AUTH_URL=https://your-branch.neonauth.example/neondb/auth
VITE_NEON_AUTH_URL=https://your-branch.neonauth.example/neondb/auth
VITE_NEON_DATA_API_URL=https://your-branch.apirest.example/neondb/rest/v1

# Canonical URL used by invitation and password-reset links.
APP_URL=http://localhost:5173

# Email address that gets admin access (e.g. ManageVideos, AdminInvite).
VITE_ADMIN_EMAIL=you@example.com
